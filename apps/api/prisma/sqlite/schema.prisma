generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/sqlite-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vehicle {
  issues VehicleIssue[]
  id               String    @id @default(cuid())
  vehicleNumber    String    @unique
  licensePlate     String?
  currentTrailerPlate String?
  manualPositionAddress String?
  manualPositionLatitude Float?
  manualPositionLongitude Float?
  manualPositionAt DateTime?
  maxSpeedKmh      Int       @default(85)
  clockState       String?
  manualStoppedAt  DateTime?
  operationVersion Int       @default(0)
  truckProfile   String?
  assignedDispatcherId String?
  assignedAt     DateTime?
  /// Customer line: SCHNELLECKE | WALTER_TESLA | OTHER. Only SCHNELLECKE trucks get the 07:00 status list.
  line           String?
  /// Block in the status list: NORD | SUED | LUFE.
  statusGroup    String?
  /// The truck's service phone for the status list, never a driver's personal number.
  servicePhone   String?
  aSchild        Boolean  @default(false)
  appSped        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignedDispatcher Dispatcher? @relation(fields: [assignedDispatcherId], references: [id], onDelete: SetNull)
  tours  Tour[]
  events Event[]
  alerts Alert[]
  integrations VehicleIntegration[]
  telemetry VehicleTelemetry[]
  dailyStatusRows DailyStatusRow[]

  @@index([assignedDispatcherId])
  @@index([line, statusGroup])
}

model Tour {
  id             String    @id @default(cuid())
  vehicleId      String
  orderNumber    String
  importAttemptId String?  @unique
  importFingerprint String? @unique
  trailerPlate   String?
  tourRemarks    String?
  approachDurationSeconds Int?
  approachDistanceMeters Int?
  approachGeometry String?
  planVersion    Int       @default(0)
  queueIndex     Int       @default(0)
  status         String    @default("DRAFT")
  previousTourId String?
  plannedStartAt DateTime?
  actualStartAt  DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehicle      Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  previousTour Tour?   @relation("TourChain", fields: [previousTourId], references: [id])
  nextTours    Tour[]  @relation("TourChain")
  stops        Stop[]
  legs         Leg[]
  events       Event[]
  alerts       Alert[]
  document     OrderDocument?

  @@index([vehicleId, status])
  @@index([previousTourId])
}

model Stop {
  id                String    @id @default(cuid())
  tourId            String
  sequence          Int
  type              String
  company           String?
  address           String
  sourceAddress     String?
  resolvedAddress   String?
  geocodePrecision  String?
  geocodeProvider   String?
  city              String?
  latitude          Float
  longitude         Float
  appointmentAt     DateTime?
  appointmentWindowStartAt DateTime?
  appointmentWindowEndAt DateTime?
  loadingMeters     Float?
  referenceNumbersJson String?
  instructions     String?
  arrivedAt         DateTime?
  arrivalRadiusMeters Int?
  plannedAt     DateTime?
  departureDeadlineAt DateTime?
  terminRequired Boolean @default(false)
  serviceMinMinutes Int       @default(60)
  serviceMaxMinutes Int       @default(120)
  completedAt       DateTime?
  createdAt         DateTime  @default(now())

  tour     Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  fromLegs Leg[]   @relation("LegFromStop")
  toLegs   Leg[]   @relation("LegToStop")
  events   Event[]
  alerts   Alert[]

  @@unique([tourId, sequence])
  @@index([tourId, sequence])
}

model Leg {
  id                       String    @id @default(cuid())
  tourId                   String
  fromStopId               String
  toStopId                 String
  distanceMeters           Int
  routeGeometry            String
  routingDurationSeconds   Int
  simulatedDurationSeconds Int
  drivePlan                String?
  routeDetails             String?
  startedAt                DateTime?
  finishedAt               DateTime?
  status                   String    @default("WAITING")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tour     Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)
  fromStop Stop @relation("LegFromStop", fields: [fromStopId], references: [id], onDelete: Cascade)
  toStop   Stop @relation("LegToStop", fields: [toStopId], references: [id], onDelete: Cascade)

  @@index([tourId, status])
}

model Event {
  id        String   @id @default(cuid())
  vehicleId String
  tourId    String
  stopId    String
  type      String
  timestamp DateTime
  note      String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tour    Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  stop    Stop    @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([vehicleId, timestamp])
  @@index([tourId, timestamp])
}

model Alert {
  id                   String    @id @default(cuid())
  vehicleId            String
  tourId               String
  stopId               String
  type                 String
  appointmentAt        DateTime
  predictedEta         DateTime
  predictedLateMinutes Int
  createdAt            DateTime  @default(now())
  resolvedAt           DateTime?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tour    Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  stop    Stop    @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([stopId, type])
  @@index([vehicleId, resolvedAt])
}

model ApiQuota {
  id        String   @id
  used      Int      @default(0)
  updatedAt DateTime @updatedAt
}

model OperationEvent {
  id          String   @id @default(cuid())
  vehicleId   String
  tourId      String?
  stopId      String?
  type        String
  payloadJson String
  reason      String?
  createdAt   DateTime @default(now())

  @@index([vehicleId, createdAt])
}

model Notification {
  id             String    @id @default(cuid())
  dedupKey       String    @unique
  vehicleId      String
  stopId         String?
  type           String
  message        String
  payloadJson    String
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  @@index([acknowledgedAt, createdAt])
}

model RouteRevision {
  id           String   @id @default(cuid())
  tourId       String
  version      Int
  snapshotJson String
  createdAt    DateTime @default(now())

  @@index([tourId, version])
}

model RoutePreview {
  id             String    @id @default(cuid())
  tourId         String
  version        Int
  vehicleVersion Int
  inputJson      String
  planJson       String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  appliedAt      DateTime?

  @@index([tourId, createdAt])
}

model VehicleIntegration {
  id String @id @default(cuid())
  vehicleId String
  provider String
  externalId String
  externalNumber String?
  externalPlate String?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@unique([provider, vehicleId])
  @@index([provider, externalNumber])
  @@index([provider, externalPlate])
}

model VehicleTelemetry {
  id String @id @default(cuid())
  vehicleId String
  provider String
  externalId String
  latitude Float
  longitude Float
  speedKmh Float?
  ignitionOn Boolean?
  recordedAt DateTime
  receivedAt DateTime @default(now())
  rawJson String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId, recordedAt])
  @@index([vehicleId, recordedAt])
}

model IntegrationSyncState {
  id String @id
  provider String
  cursor String?
  lockedUntil DateTime?
  lastSnapshotAt DateTime?
  updatedAt DateTime @updatedAt

  @@index([provider, lockedUntil])
}

model IntegrationReceipt {
  id String @id @default(cuid())
  provider String
  messageId String
  externalId String?
  processedAt DateTime @default(now())
  acknowledgedAt DateTime?
  payloadJson String?

  @@unique([provider, messageId])
  @@index([provider, acknowledgedAt])
}
model AssistantConversation {
  id String @id @default(cuid())
  title String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages AssistantMessage[]
  proposals AssistantProposal[]
}
model AssistantMessage {
  id String @id @default(cuid())
  conversationId String
  role String
  content String
  createdAt DateTime @default(now())
  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}
model AssistantProposal {
  id String @id @default(cuid())
  conversationId String
  vehicleId String?
  vehicleVersion Int?
  contextJson String
  action String
  summary String
  inputJson String
  previewJson String
  status String @default("PENDING")
  resultJson String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  appliedAt DateTime?
  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}
model AssistantUsage {
  id String @id
  count Int @default(0)
  expiresAt DateTime
}
model VehicleIssue {
  id String @id @default(cuid())
  vehicleId String
  kind String
  description String
  expectedResolvedAt DateTime?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  @@index([vehicleId, resolvedAt])
}

model AuditLog {
  id String @id @default(cuid())
  actorRole String
  actorSessionId String
  actorDispatcherId String?
  action String
  entityType String
  entityId String
  vehicleId String?
  tourId String?
  stopId String?
  metadataJson String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorSessionId, createdAt])
  @@index([actorDispatcherId, createdAt])
}

/// Personal dispatcher account. Only what login needs: no e-mail or phone (DSGVO).
model Dispatcher {
  id String @id @default(cuid())
  login String @unique
  displayName String
  role String @default("dispatcher")
  passwordHash String
  active Boolean @default(true)
  lastLoginAt DateTime?
  onboardingCompletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
}

/// Appointment slip (Termin) recognised from a document before a matching stop exists. Never deleted: only the status changes.
model PendingAppointment {
  id                    String    @id @default(cuid())
  documentKind          String
  fingerprint           String    @unique
  vehiclePlate          String?
  vehicleId             String?
  company               String?
  site                  String?
  city                  String?
  stopType              String?
  appointmentAt         DateTime?
  windowStartAt         DateTime?
  windowEndAt           DateTime?
  referencesJson        String?
  sourceExcerpt         String?
  status                String    @default("PENDING")
  attachedStopId        String?
  createdByDispatcherId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([vehicleId, status])
}

/// Learned and edited address knowledge for Auftrag import: "vw" → Volkswagen, "wob" → Wolfsburg, "seifert bremen" → its gate.
model AddressRule {
  id                    String   @id @default(cuid())
  pattern               String   @unique
  kind                  String
  company               String?
  street                String?
  postalCode            String?
  city                  String?
  latitude              Float?
  longitude             Float?
  requiresTermin        Boolean  @default(false)
  hits                  Int      @default(0)
  createdByDispatcherId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// The 07:00 status list of one customer line for one Berlin day (owner decision 2026-11-05). The unique (line, date) is the lock against a double run.
model DailyStatusReport {
  id                      String    @id @default(cuid())
  line                    String
  date                    String
  status                  String    @default("GENERATING")
  preliminary             Boolean   @default(false)
  generatedAt             DateTime?
  generatedByRole         String
  generatedByDispatcherId String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  rows DailyStatusRow[]

  @@unique([line, date])
}

/// One truck in a status list: a snapshot, so a past list never changes. No driver name or id (DSGVO).
model DailyStatusRow {
  id                   String    @id @default(cuid())
  reportId             String
  vehicleId            String?
  vehicleNumber        String
  statusGroup          String?
  sortIndex            Int
  rule                 String
  ort                  String?
  ortSource            String?
  startAt              DateTime?
  startKind            String
  ziel                 String?
  ankunftAt            DateTime?
  ankunftKind          String
  bemerkungAuto        String?
  bemerkung            String?
  overridesJson        String?
  weNortheim           String?
  trailer              String?
  trailerSource        String?
  servicePhone         String?
  aSchild              Boolean   @default(false)
  appSped              Boolean   @default(false)
  tourId               String?
  stopId               String?
  detailsJson          String?
  version              Int       @default(0)
  editedAt             DateTime?
  editedByDispatcherId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  report  DailyStatusReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  vehicle Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([reportId, vehicleId])
  @@index([reportId, sortIndex])
}

/// Saved addresses (plants, warehouses, gates) for address suggestions. Read from the Webfleet address book; no contacts or phones (DSGVO).
model KnownAddress {
  id             String   @id @default(cuid())
  source         String
  externalId     String
  externalNumber String?
  name           String
  name2          String?
  street         String?
  postalCode     String?
  city           String?
  country        String?
  region         String?
  latitude       Float
  longitude      Float
  radiusMeters   Int?
  groups         String?
  searchText     String
  active         Boolean  @default(true)
  useCount       Int      @default(0)
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([source, externalId])
  @@index([active])
}

/// The uploaded Auftrag (PDF, image, XLSX) with what the AI read from it and what the dispatcher saved. Bytes are read only by the file route.
model OrderDocument {
  id                     String    @id @default(cuid())
  sha256                 String    @unique
  filename               String
  mimeType               String
  size                   Int
  content                Bytes
  previewJson            String
  confirmedJson          String?
  status                 String    @default("PENDING")
  uploadedByDispatcherId String?
  vehicleId              String?
  tourId                 String?   @unique
  attachedAt             DateTime?
  createdAt              DateTime  @default(now())

  tour        Tour?              @relation(fields: [tourId], references: [id])
  corrections ImportCorrection[]

  @@index([status, createdAt])
  @@index([vehicleId, createdAt])
}

/// One correction a dispatcher made to an AI-read stop before saving the tour. Never updated or deleted.
model ImportCorrection {
  id           String   @id @default(cuid())
  documentId   String
  tourId       String?
  dispatcherId String?
  kind         String
  field        String?
  aiValue      String?
  finalValue   String?
  contextJson  String?
  signature    String
  createdAt    DateTime @default(now())

  document OrderDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([signature, createdAt])
  @@index([documentId])
  @@index([tourId])
}

/// Import rule learned from repeated corrections (alias, ignored label, stop type); active once the threshold is reached.
model ImportRule {
  id         String    @id @default(cuid())
  kind       String
  pattern    String
  value      String?
  active     Boolean   @default(false)
  hits       Int       @default(0)
  applied    Int       @default(0)
  builtIn    Boolean   @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([kind, pattern])
}
