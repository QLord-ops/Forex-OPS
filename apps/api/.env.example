# Database and runtime
DATABASE_URL=
DATABASE_URL_UNPOOLED=
SQLITE_SOURCE_PATH=
API_HOST=
API_PORT=
ALLOWED_ORIGINS=

# Dispatcher authentication. Generate the password hash offline; never store a plaintext password.
ADMIN_PASSWORD_HASH=
DISPATCHER_PASSWORD_HASH=
SESSION_SECRET=
DISPATCHER_ALLOWED_ORIGINS=
SSE_MAX_CONNECTIONS_PER_SESSION=

# OpenAI is server-side only.
OPENAI_API_KEY=
OPENAI_IMPORT_MODEL=
OPENAI_ASSISTANT_MODEL=
OPENAI_ADDRESS_RESEARCH_ENABLED=
OPENAI_ADDRESS_RESEARCH_MODEL=
OPENAI_ADDRESS_RESEARCH_MONTHLY_LIMIT=
OPENAI_MONTHLY_LIMIT=
ASSISTANT_MINUTE_LIMIT=
ASSISTANT_DAILY_LIMIT=

# Geocoding and routing providers
NOMINATIM_BASE_URL=
NOMINATIM_USER_AGENT=
OSRM_BASE_URL=
ROUTING_ALLOW_MOCK=

# TomTom server-side routing. TOMTOM_ROUTING_API_KEY is a legacy alias.
TOMTOM_API_KEY=
TOMTOM_ROUTING_API_KEY=
TOMTOM_FREE_TIER_CONFIRMED=
TOMTOM_ROUTING_BASE_URL=
TOMTOM_ROUTING_LANGUAGE=
TOMTOM_ROUTING_MONTHLY_CAP=
TOMTOM_MANUAL_RESERVE_RATIO=

# Webfleet server-side read-only integration.
# Check once with: npm run webfleet:check -w @ops/api (read-only, prints no secrets).
WEBFLEET_ACCOUNT=
WEBFLEET_API_KEY=
WEBFLEET_USERNAME=
WEBFLEET_PASSWORD=
WEBFLEET_BASE_URL=
# Automatic GPS arrival (stop zone + 3 min standstill). Set to false to keep only a suggestion.
AUTO_ARRIVAL_ENABLED=
# Automatic BELADEN/ENTLADEN after a 20 min stay once the truck is 10 km away. Set to false to keep only the question.
AUTO_STOP_EVENT_ENABLED=

# Push notifications to the dispatchers' phones (PWA). Generate once with `npm run push:keys -w @ops/api`
# and put the values into the DigitalOcean app environment. Empty: push is off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dispo@example.com
