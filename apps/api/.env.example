# Рабочее подключение приложения. Для Vercel используйте строку управляемого
# connection pool (PgBouncer) в том же регионе, что и API.
DATABASE_URL="postgresql://USER:PASSWORD@POOL_HOST:PORT/DATABASE?sslmode=require"

# Прямое подключение используется только для Prisma migrations и обслуживания.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@PRIMARY_HOST:PORT/DATABASE?sslmode=require"
API_HOST="127.0.0.1"
API_PORT="3001"

# Нужен для распознавания PDF-заказов. Храните ключ только на стороне сервера.
OPENAI_API_KEY=""
OPENAI_IMPORT_MODEL="gpt-5.4-mini"

# Бесплатные настройки маршрутизации. Для продакшена укажите собственные управляемые сервисы.
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org/"
NOMINATIM_USER_AGENT="ops-disponent-local/1.0"
OSRM_BASE_URL="https://router.project-osrm.org/"

# Необязательная маршрутизация TomTom с пробками. Включайте только после подтверждения условий бесплатного тарифа.
# Используйте отдельный ключ: приложение не может учитывать запросы, выполненные за его пределами.
# Не подключайте платное превышение квоты: локальные лимиты не контролируют другие приложения.
TOMTOM_API_KEY=""
TOMTOM_FREE_TIER_CONFIRMED="false"
TOMTOM_ROUTING_BASE_URL="https://api.tomtom.com/"
TOMTOM_ROUTING_LANGUAGE="ru-RU"
TOMTOM_ROUTING_MONTHLY_CAP="18000"
TOMTOM_MANUAL_RESERVE_RATIO="0.2"

# Webfleet используется только на сервере, в режиме чтения телеметрии.
# Создайте отдельного пользователя WEBFLEET.connect без прав на водителей и изменение заказов.
WEBFLEET_ACCOUNT=""
WEBFLEET_API_KEY=""
WEBFLEET_USERNAME=""
WEBFLEET_PASSWORD=""
WEBFLEET_BASE_URL="https://csv.webfleet.com/extern"

# Только для разработки и демонстрации. В обычной работе адреса нельзя подтверждать автоматически.
ROUTING_ALLOW_MOCK="false"
