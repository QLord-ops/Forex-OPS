{
  "name": "@ops/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "node scripts/migrate-on-deploy.mjs && npm run prisma:generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate && prisma generate --schema prisma/sqlite/schema.prisma",
    "push:keys": "node scripts/push-keys.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:deploy": "node scripts/migrate.mjs",
    "db:import-sqlite": "node scripts/import-sqlite.mjs",
    "db:reset": "npm run db:deploy && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "auth:secrets": "tsx src/cli/auth-secrets.ts",
    "webfleet:check": "tsx src/cli/webfleet-check.ts",
    "webfleet:addresses": "tsx src/cli/webfleet-address-check.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/client": "6.1.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "prisma": "6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
